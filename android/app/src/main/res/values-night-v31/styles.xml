<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ açılış ekranı: krem zemin + Haven ikonu (Flutter logosu yerine Haven kalkan).
     Uygulama içi tema her zaman açık pastel olduğundan gece modunda da aynı. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/haven_cream</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/haven_cream</item>
    </style>
</resources>
